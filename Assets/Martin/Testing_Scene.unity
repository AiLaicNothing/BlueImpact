  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5f0f5f8175c289441aa84c10178196b1, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TutorialPopUp
  pages:
  - title: "Bloque de c\xE1mara en objetivo"
    description: "Con la tecla \"Q\" si tienes enemigos en tu campo de visi\xF3n,
      bloquea la c\xE1mara para la direcci\xF3n del enemigo, puedes cambiar de objetivo
      entre enemigos moviendo la rueda del rat\xF3n."
    texture: {fileID: 8400000, guid: 3466179e080d56f49ab25866bd970d5b, type: 2}
    video: {fileID: 0}
  - title: Ataque principal
    description: Dependiendo del personaje con el "click izquierdo "realizara una
      secuencia de ataques.
    texture: {fileID: 8400000, guid: 3466179e080d56f49ab25866bd970d5b, type: 2}
    video: {fileID: 0}
  - title: Ataque cuerpo a cuerpo
    description: "Con la tecla \"F\" todos los personajes tienen una opci\xF3n de
      ataque de cuerpo a cuerpo."
    texture: {fileID: 8400000, guid: 3466179e080d56f49ab25866bd970d5b, type: 2}
    video: {fileID: 0}
  - title: Ruptura de guardia
    description: "Los enemigos tienen una barra de guardia, al recibir golpes subes
      la ruptura de guardia, al llegar al m\xE1ximo entrar\xE1n en un estado de debilidad
      donde son aptos a recibir m\xE1s da\xF1os y a empujes."
    texture: {fileID: 8400000, guid: 3466179e080d56f49ab25866bd970d5b, type: 2}
    video: {fileID: 0}
