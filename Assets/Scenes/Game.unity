  m_EditorClassIdentifier: Assembly-CSharp::TutorialPopUp
  pages:
  - title: Puntos de guardado
    description: Puedes interactuar con esta estructura para obtener ciertas funciones.
    texture: {fileID: 8400000, guid: 3466179e080d56f49ab25866bd970d5b, type: 2}
    video: {fileID: 32900000, guid: 6a882ccddce07704dbe27aa723df7c6a, type: 3}
  - title: Ajustes de estadisticas
    description: "En la opci\xF3n de estad\xEDsticas puedes subir tus estad\xEDsticas
      en base a la cantidad de puntos disponibles que tienes. Subir puntos reduce
      otras estad\xEDstacas, pero aumenta dr\xE1sticamente la estad\xEDstica seleccionada."
    texture: {fileID: 8400000, guid: 3466179e080d56f49ab25866bd970d5b, type: 2}
    video: {fileID: 32900000, guid: eefbf745cfd638c4ca597c3d04c3fb18, type: 3}
  - title: Equipamiento de habilidades
    description: Selecciona una habilidad de la casilla de habilidades disponibles,
      luego selecciona la casilla de espacio de habilidad del jugador.
    texture: {fileID: 8400000, guid: 3466179e080d56f49ab25866bd970d5b, type: 2}
    video: {fileID: 32900000, guid: 9917f62eb05d1bf46ab87516d466d332, type: 3}
